{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/pages/*": ["./src/types/page-shim.d.ts"],
      "@/hooks/*": ["./src/types/hooks-shim.d.ts"],
      "@/components/molecules/LazyComponents": ["./src/types/lazycomponents-shim.d.ts"],
      "@/components/routing/DeviceRouter": ["./src/types/router-shim.d.ts"],
      "@/App": ["./src/types/app-shim.d.ts"]
    }
  },
  "include": [
    "src/router.tsx",
    "src/routes/**/*",
    "src/utils/seo.ts",
    "src/utils/multilingualRoutes.ts",
    "src/config/**/*",
    "scripts/generate-dynamic-sitemap.ts"
  ],
  "exclude": [
    "src/pages/**/*",
    "src/components/**/*",
    "src/__tests__/**/*"
  ]
}
