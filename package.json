{
  "name": "zhonghuayidian-tcm-platform",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:astro": "astro dev",
    "build": "npm run prebuild && npm run build:client && (npm run build:server || echo SSR skipped) && node scripts/build/post-build.js && node scripts/build/generate-cf-worker.mjs && node scripts/tools/check-links.mjs --mode=prod && node scripts/seo/check-seo-coverage.js",
    "build:astro": "astro build",
    "build:client": "vite build",
    "build:server": "vite build --ssr",
    "build:prod": "npm run prebuild && npm run build:client && (npm run build:server || echo SSR skipped) && node scripts/build/post-build.js && node scripts/build/generate-cf-worker.mjs && node scripts/tools/check-links.mjs --mode=prod && node scripts/seo/check-seo-coverage.js",
    "build:dev": "npm run prebuild && npm run build:client && (npm run build:server || echo SSR skipped) && node scripts/build/post-build.js && node scripts/build/generate-cf-worker.mjs && node scripts/tools/check-links.mjs --mode=dev && node scripts/seo/check-seo-coverage.js",
    "audit:dev": "npm run build:dev && node scripts/tools/check-links.mjs --mode=dev",
    "audit:prod": "npm run build:prod && node scripts/tools/check-links.mjs --mode=prod",
    "audit:strict": "npm run build:prod && node -e \"process.env.CHECK_STRICT_HEAD='1';process.env.CHECK_STRICT_SITEMAP='1';process.env.CHECK_STRICT_REDIRECTS='1';import('./scripts/tools/check-links.mjs')\" -- --mode=prod",
    "audit:strict:dev": "npm run build:dev && node -e \"process.env.CHECK_STRICT_HEAD='1';process.env.CHECK_STRICT_SITEMAP='1';process.env.CHECK_STRICT_REDIRECTS='1';import('./scripts/tools/check-links.mjs')\" -- --mode=dev",
    "lint": "eslint .",
    "check:syntax": "node scripts/checks/check-syntax.js",
    "check:hardcode": "node scripts/checks/check-hardcode.cjs",
    "seo:check": "node scripts/seo/check-seo-coverage.js",
    "preview": "vite preview",
    "preview:astro": "astro preview",
    "i18n:check": "node scripts/i18n/check-translations.js",
