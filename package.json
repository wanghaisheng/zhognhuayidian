    "generate:stats": "npx tsx scripts/build/generate-content-stats.ts",
    "generate:snapshots": "node scripts/build/generate-markdown-snapshots.mjs && node scripts/build/generate-snapshots.mjs",
    "content:fix-frontmatter": "node scripts/tools/fix-frontmatter.mjs",
    "prebuild": "npm run generate:snapshots && npm run generate:routes && npm run generate:sitemap && npm run generate:prerender",
    "db:fix-manufacturer-slugs": "npx tsx scripts/tools/fix-manufacturer-slugs.ts",
    "test:locale-home": "node scripts/checks/test-locale-home.js",
    "test:redirects-dev": "node scripts/checks/test-redirects-dev.js",
    "test:seo-head": "node scripts/checks/test-seo-head.js",
