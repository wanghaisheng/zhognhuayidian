---
import I18nProvider from '@/components/I18nProvider';
import { getLanguageFromPath } from '@/utils/multilingualRoutes';
import { buildPageHead } from '@/utils/seo';
import i18n from '@/lib/i18n';

// SEO 配置
const locale = getLanguageFromPath(Astro.url.pathname) || 'en';
const head = buildPageHead('/resources', locale);
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{head.title}</title>
    <meta name="description" content={head.description} />
    {head.meta.map(meta => <meta {...meta} />)}
    {head.links.map(link => <link {...link} />)}
  </head>
  <body>
    <I18nProvider client:load>
      <div className="container mx-auto px-4 py-8">
        <div className="max-w-6xl mx-auto">
          <h1 className="text-4xl font-bold mb-8">
            {i18n.language === 'zh' ? '学习资源' : 'Learning Resources'}
          </h1>
          
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
            <div className="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
              <div className="text-blue-600 mb-4">
                <svg className="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <h2 className="text-xl font-semibold mb-2">
                {i18n.language === 'zh' ? '古籍文献' : 'Classical Texts'}
              </h2>
              <p className="text-gray-600 mb-4">
                {i18n.language === 'zh' ? '黄帝内经、伤寒论、金匮要略等经典古籍全文阅读' : 'Full-text reading of classical texts like Huangdi Neijing, Shanghan Lun, and Jingui Yaolue'}
              </p>
              <a href="/library" className="text-blue-600 hover:text-blue-800 font-medium">
                {i18n.language === 'zh' ? '浏览古籍' : 'Browse Classics'} →
              </a>
            </div>

            <div className="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
              <div className="text-green-600 mb-4">
                <svg className="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <h2 className="text-xl font-semibold mb-2">
                {i18n.language === 'zh' ? '术语词典' : 'Glossary'}
              </h2>
              <p className="text-gray-600 mb-4">
                {i18n.language === 'zh' ? '中医术语解释、概念说明、发音指南' : 'TCM terminology explanations, concept descriptions, pronunciation guides'}
              </p>
              <a href="/glossary" className="text-green-600 hover:text-green-800 font-medium">
                {i18n.language === 'zh' ? '查看术语' : 'View Glossary'} →
              </a>
            </div>

            <div className="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
              <div className="text-purple-600 mb-4">
                <svg className="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h2 className="text-xl font-semibold mb-2">
                {i18n.language === 'zh' ? '发展历史' : 'History'}
              </h2>
              <p className="text-gray-600 mb-4">
                {i18n.language === 'zh' ? '中医发展历程、历代名医、重要事件' : 'TCM development history, famous physicians, important events'}
              </p>
              <a href="/history" className="text-purple-600 hover:text-purple-800 font-medium">
                {i18n.language === 'zh' ? '探索历史' : 'Explore History'} →
              </a>
            </div>

            <div className="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
              <div className="text-orange-600 mb-4">
                <svg className="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
              </div>
              <h2 className="text-xl font-semibold mb-2">
                {i18n.language === 'zh' ? '学习中心' : 'Learning Center'}
              </h2>
              <p className="text-gray-600 mb-4">
                {i18n.language === 'zh' ? '系统化课程、理论讲解、实践指导' : 'Systematic courses, theory explanations, practical guidance'}
              </p>
              <a href="/learn" className="text-orange-600 hover:text-orange-800 font-medium">
                {i18n.language === 'zh' ? '开始学习' : 'Start Learning'} →
              </a>
            </div>

            <div className="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
              <div className="text-red-600 mb-4">
                <svg className="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <h2 className="text-xl font-semibold mb-2">
                {i18n.language === 'zh' ? '智能检索' : 'Smart Search'}
              </h2>
              <p className="text-gray-600 mb-4">
                {i18n.language === 'zh' ? 'AI驱动的语义搜索、症状匹配、方剂推荐' : 'AI-powered semantic search, symptom matching, prescription recommendations'}
              </p>
              <a href="/search" className="text-red-600 hover:text-red-800 font-medium">
                {i18n.language === 'zh' ? '开始搜索' : 'Start Search'} →
              </a>
            </div>

            <div className="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
              <div className="text-indigo-600 mb-4">
                <svg className="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              </div>
              <h2 className="text-xl font-semibold mb-2">
                {i18n.language === 'zh' ? '学术研究' : 'Research'}
              </h2>
              <p className="text-gray-600 mb-4">
                {i18n.language === 'zh' ? '基于古籍的深度学术研究、论文发表、数据挖掘' : 'In-depth academic research based on classics, paper publications, data mining'}
              </p>
              <a href="/research" className="text-indigo-600 hover:text-indigo-800 font-medium">
                {i18n.language === 'zh' ? '查看研究' : 'View Research'} →
              </a>
            </div>
          </div>

          <div className="bg-blue-50 rounded-lg p-8">
            <h2 className="text-2xl font-semibold mb-4">
              {i18n.language === 'zh' ? '如何使用这些资源？' : 'How to Use These Resources?'}
            </h2>
            <div className="prose prose-lg max-w-none text-gray-700">
              <p className="mb-4">
                {i18n.language === 'zh' 
                  ? '中华医典提供了丰富的学习资源，帮助您系统学习中医知识。建议从基础理论开始，逐步深入到临床应用。' 
                  : 'Zhonghua Yidian provides rich learning resources to help you systematically study TCM knowledge. It is recommended to start with basic theories and gradually move to clinical applications.'}
              </p>
              <ul className="list-disc pl-6 space-y-2">
                <li>
                  {i18n.language === 'zh' 
                    ? '初学者：从术语词典和古籍文献开始，建立基础知识' 
                    : 'Beginners: Start with the glossary and classical texts to build foundational knowledge'}
                </li>
                <li>
                  {i18n.language === 'zh' 
                    ? '进阶学习者：使用学习中心的系统化课程，深入学习理论' 
                    : 'Intermediate learners: Use the systematic courses in the learning center to deeply study theories'}
                </li>
                <li>
                  {i18n.language === 'zh' 
                    ? '研究者：利用智能检索和学术研究功能，进行深度研究' 
                    : 'Researchers: Utilize smart search and academic research features for in-depth study'}
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </I18nProvider>
  </body>
</html>
