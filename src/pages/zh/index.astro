---
import AppLayout from '../../layouts/AppLayout.astro';
import IndexPage from '../../components/pages/Index';
import I18nProvider from '../../components/I18nProvider';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import i18n from '../../lib/i18n';

// Astro 负责数据获取
const { getOrCreateStorageAdapter } = await import('../../lib/storage/factory');
const adapter = await getOrCreateStorageAdapter();

// 获取统计数据
const statsResult = await adapter.query('manufacturers', { 
  select: ['id'] 
});

const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      refetchOnWindowFocus: false,
      retry: 1,
    },
  },
});
---

<AppLayout title="中华医典 - 中国医疗器械数据库">
  <I18nProvider client:visible>
    <QueryClientProvider client={queryClient}>
      <IndexPage 
        client:visible 
        initialStats={statsResult.data || []}
      />
    </QueryClientProvider>
  </I18nProvider>
</AppLayout>
