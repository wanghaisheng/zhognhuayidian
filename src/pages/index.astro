---
import IndexPage from '@/components/pages/IndexPage';
import I18nProvider from '@/components/I18nProvider';
import { getLanguageFromPath } from '@/utils/multilingualRoutes';
import { getLocalizedSEOConfig, generateCanonicalUrl, optimizeDescription } from '@/utils/seo';
import i18n from '@/lib/i18n';

// SEO 配置
const locale = getLanguageFromPath(Astro.url.pathname) || 'zh';
const basePath = '/';
const localized = getLocalizedSEOConfig(locale, basePath) || null;
const title = (localized?.title as string) || '中华医典 - 中国医疗器械数据库';
const descriptionBase = (localized?.description as string) || '传承中医智慧 · 弘扬中华文化，收录中国历代医学古籍1000部，卷帙上万，4亿字';
const description = optimizeDescription(descriptionBase, locale);
const canonical = generateCanonicalUrl(basePath, locale);
const ogImage = `${canonical.replace(/\/+$/, '')}/placeholder.svg`;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <I18nProvider client:load>
      <IndexPage client:load />
    </I18nProvider>
  </body>
</html>
