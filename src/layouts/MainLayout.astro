---
interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { 
  title, 
  description = '中华医典 - 中国医疗器械数据库，提供CT、MRI等医疗设备的详细信息、价格对比和采购指南。',
  lang = 'en'
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
